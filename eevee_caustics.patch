+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Real-world physical caustics implementation for EEVEE.
+ * Evaluates refractive diacaustics with chromatic dispersion and
+ * reflective catacaustics with cardioid/nephroid focal envelopes.
+ */
+
+#pragma once
+
+#include "DRW_gpu_wrapper.hh"
+#include "draw_pass.hh"
+
+namespace blender::eevee {
+
+using namespace draw;
+
+class Instance;
+
+class CausticsModule {
+ private:
+  Instance &inst_;
+
+  bool enabled_ = false;
+
+  struct {
+    float intensity = 1.0f;
+    float dispersion = 0.05f;
+    float blur = 0.2f;
+    int flags = 3;
+  } data_;
+
+  draw::PassSimple caustics_ps_ = {"Caustics.Eval"};
+
+ public:
+  CausticsModule(Instance &inst) : inst_(inst) {}
+  ~CausticsModule() = default;
+
+  void init();
+  void sync();
+  void render(View &view, Framebuffer &combined_fb);
+};
+
+}  // namespace blender::eevee
