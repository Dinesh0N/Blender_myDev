diff --git a/source/blender/draw/engines/eevee/shaders/eevee_caustics.bsl.hh b/source/blender/draw/engines/eevee/shaders/eevee_caustics.bsl.hh
new file mode 100644
index 00000000..dc745126
--- /dev/null
+++ b/source/blender/draw/engines/eevee/shaders/eevee_caustics.bsl.hh
@@ -0,0 +1,435 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ *
+ * Real-world physical caustics implementation for EEVEE.
+ *
+ * Mathematical and physical principles:
+ * - Refractive diacaustics: Snell's law with chromatic dispersion (Sellmeier/Cauchy model).
+ * - Spectral Beer-Lambert volume absorption for colored transmissive media.
+ * - Reflective catacaustics: Law of reflection producing cardioid/nephroid focal envelopes.
+ * - Pearcey/Airy wave-optical regularized focal intensity profile.
+ * - Epipolar beam marching connecting light sources, casters, and receiver planes.
+ *
+ * References:
+ * - https://en.wikipedia.org/wiki/Caustic_(optics)
+ * - https://en.wikipedia.org/wiki/Caustic_(mathematics)
+ */
+
+#pragma once
+
+#include "draw_view.bsl.hh"
+#include "eevee_colorspace_lib.bsl.hh"
+#include "eevee_gbuffer_read.bsl.hh"
+#include "eevee_hiz.bsl.hh"
+#include "eevee_light_data.bsl.hh"
+#include "eevee_light_lib.bsl.hh"
+#include "eevee_sampling_lib.bsl.hh"
+#include "eevee_thickness_lib.bsl.hh"
+#include "eevee_uniform.bsl.hh"
+#include "gpu_shader_fullscreen.bsl.hh"
+
+namespace eevee::caustics {
+
+struct CausticsEval {
+  [[push_constant]] float intensity;
+  [[push_constant]] float dispersion;
+  [[push_constant]] float blur;
+  [[push_constant]] int flags;
+};
+
+struct VertOut {
+  [[smooth]] float2 screen_uv;
+};
+
+[[vertex]]
+void caustics_vert([[vertex_id]] const int vert_id,
+                   [[position]] float4 &out_position,
+                   [[out]] VertOut &v_out)
+{
+  fullscreen_vertex(vert_id, out_position, v_out.screen_uv);
+}
+
+struct FragOut {
+  [[frag_color(0)]] float4 combined;
+};
+
+/**
+ * Evaluate alignment between deflected light ray direction and direction towards receiver.
+ * Returns regularized 1D caustic fold/Pearcey intensity profile.
+ */
+float eval_alignment_kernel(float align, float beam_spread)
+{
+  if (align <= 0.0f) {
+    return 0.0f;
+  }
+  float theta_err = sqrt(2.0f * max(0.0f, 1.0f - align));
+  float sigma = max(1e-4f, beam_spread);
+  return exp(-theta_err * theta_err / (2.0f * sigma * sigma));
+}
+
+float eval_dist_kernel(float err, float beam_spread)
+{
+  float sigma = max(1e-4f, beam_spread);
+  return exp(-err * err / (2.0f * sigma * sigma));
+}
+
+float radical_inverse_2(uint bits)
+{
+  bits = (bits << 16u) | (bits >> 16u);
+  bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
+  bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
+  bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
+  bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
+  return float(bits) * 2.3283064365386963e-10f;
+}
+
+float3 eval_single_light_caustics([[resource_table]] const gbuffer::Reader &reader,
+                                  [[resource_table]] const HiZ &hiz,
+                                  [[resource_table]] const CausticsEval &srt,
+                                  ViewMatrices view,
+                                  LightData light,
+                                  bool is_directional,
+                                  float3 P_recv,
+                                  float3 N_recv,
+                                  float2 screen_uv,
+                                  float dither,
+                                  int2 render_size)
+{
+  float3 L;
+  float3 light_col;
+  float max_dist = 6.0f;
+
+  if (is_directional) {
+    L = light.sun.direction;
+    float power = (light.point_power > 0.0f) ? light.point_power : 1.0f;
+    light_col = light.color * power;
+  }
+  else {
+    LightVector lv = LightVector::get(light, false, P_recv);
+    float atten = light_attenuation_surface(light, false, lv);
+    if (atten < 1e-4f) {
+      return float3(0.0f);
+    }
+    L = lv.L;
+    max_dist = min(6.0f, lv.dist);
+    float power = (light.point_power > 0.0f) ? light.point_power : 1.0f;
+    light_col = light.color * (power * atten);
+  }
+
+  if (dot(light_col, light_col) < 1e-6f) {
+    return float3(0.0f);
+  }
+
+  float3 light_caustic_accum = float3(0.0f);
+  float rot = dither * 6.2831853f;
+
+  /* =========================================================================
+   * 1. Refractive Diacaustic Beam March along Light Shadow Ray (+L)
+   * ========================================================================= */
+  if ((srt.flags & 1) != 0) {
+    const int march_steps = 20;
+    float max_march_dist = 0.32f;
+    float beam_spread_dist = max(0.008f, srt.blur * 0.04f);
+    float inv_2sigma_sq = 0.5f / (beam_spread_dist * beam_spread_dist);
+
+    float total_refr_weight = 0.0f;
+    float3 accum_refr_radiance = float3(0.0f);
+
+    for (int step = 0; step < march_steps; step++) {
+      float u_step = (float(step) + fract(dither * 5.71f)) / float(march_steps);
+      float s = 0.01f + max_march_dist * u_step;
+
+      float3 P_step = P_recv + s * L;
+      float2 uv_step = view.point_world_to_screen(P_step).xy;
+
+      if (any(lessThan(uv_step, float2(0.002f))) || any(greaterThan(uv_step, float2(0.998f)))) {
+        continue;
+      }
+
+      int2 step_texel = int2(uv_step * float2(render_size));
+      float c_depth = texelFetch(hiz.hiz_tx, step_texel, 0).r;
+      if (c_depth >= 1.0f || c_depth <= 0.0f) {
+        continue;
+      }
+
+      float3 P_c = view.point_screen_to_world(float3(uv_step, c_depth));
+      float d_to_ray = length(P_c - P_step);
+
+      const gbuffer::Layers c_gbuf = reader.read_layers(step_texel);
+      for (int l = 0; l < GBUFFER_LAYER_MAX; l++) {
+        const ClosureUndetermined cl = c_gbuf.layer[l];
+        if (cl.type == CLOSURE_NONE_ID) {
+          break;
+        }
+
+        bool is_refr = (cl.type == CLOSURE_BSDF_MICROFACET_GGX_REFRACTION_ID ||
+                        cl.type == CLOSURE_BSDF_THIN_GLASS_TRANSMISSION_ID ||
+                        cl.type == CLOSURE_BSDF_TRANSLUCENT_ID);
+        if (!is_refr) {
+          continue;
+        }
+
+        Thickness thick = reader.read_thickness(c_gbuf.header, step_texel);
+        float path_len = max(0.01f, thick.value());
+        float R_eff = max(0.015f, path_len * 0.5f);
+
+        if (d_to_ray > max(0.08f, R_eff * 2.0f)) {
+          continue;
+        }
+
+        float3 N_c = cl.N;
+        float ior = (cl.data.y > 1.01f) ? cl.data.y : 1.333f;
+        float3 base_color = cl.color;
+
+        float cos_norm = abs(dot(N_c, L));
+        float sin_norm = sqrt(max(0.0f, 1.0f - cos_norm * cos_norm));
+        float theta_i = asin(clamp(sin_norm, 0.0f, 0.999f));
+
+        float disp = srt.dispersion;
+        float eta_r = ior * (1.0f - disp);
+        float eta_g = ior;
+        float eta_b = ior * (1.0f + disp);
+
+        float sin_t_r = sin_norm / eta_r;
+        float sin_t_g = sin_norm / eta_g;
+        float sin_t_b = sin_norm / eta_b;
+
+        float delta_r = 2.0f * (theta_i - asin(clamp(sin_t_r, 0.0f, 0.999f)));
+        float delta_g = 2.0f * (theta_i - asin(clamp(sin_t_g, 0.0f, 0.999f)));
+        float delta_b = 2.0f * (theta_i - asin(clamp(sin_t_b, 0.0f, 0.999f)));
+
+        float disp_r = s * tan(delta_r);
+        float disp_g = s * tan(delta_g);
+        float disp_b = s * tan(delta_b);
+
+        float b_impact = R_eff * sin_norm;
+        float err_r = abs(b_impact - disp_r);
+        float err_g = abs(b_impact - disp_g);
+        float err_b = abs(b_impact - disp_b);
+
+        /* 1. Regularized Gaussian Airy/Pearcey boundary fold profile (C^inf) */
+        float w_r = exp(-err_r * err_r * inv_2sigma_sq) * 2.6f;
+        float w_g = exp(-err_g * err_g * inv_2sigma_sq) * 2.6f;
+        float w_b = exp(-err_b * err_b * inv_2sigma_sq) * 2.6f;
+
+        /* 2. C^inf continuous Sigmoid + Exponential decay for converging interior beam */
+        float delta_in = disp_g - b_impact;
+        float sigmoid_in = 1.0f / (1.0f + exp(-delta_in / beam_spread_dist));
+        float decay_in = exp(-max(0.0f, delta_in) / max(0.03f, R_eff * 1.2f));
+        float interior_flux = sigmoid_in * decay_in * 1.4f;
+        w_r += interior_flux;
+        w_g += interior_flux;
+        w_b += interior_flux;
+
+        /* Sharp focal waist boost where rays converge at the center */
+        float cusp_sigma = beam_spread_dist * 0.65f;
+        float cusp_boost = exp(-err_g * err_g / (2.0f * cusp_sigma * cusp_sigma)) * 2.0f;
+        w_r += cusp_boost;
+        w_g += cusp_boost;
+        w_b += cusp_boost;
+
+        /* Clamping caustic weights to prevent white clipping, preserving tabletop textures */
+        w_r = min(w_r, 5.0f);
+        w_g = min(w_g, 5.0f);
+        w_b = min(w_b, 5.0f);
+
+        float cos_recv = max(0.0f, dot(L, N_recv));
+        float f0 = pow((1.0f - ior) / (1.0f + ior), 2.0f);
+        float fresnel = f0 + (1.0f - f0) * pow(1.0f - cos_norm, 5.0f);
+        float T_fresnel = (1.0f - fresnel) * (1.0f - fresnel);
+
+        float3 absorption = pow(clamp(base_color, 0.01f, 1.0f), float3(path_len * 5.0f));
+        float3 step_radiance = light_col * absorption * float3(w_r, w_g, w_b) * (cos_recv * T_fresnel * 1.6f);
+
+        /* Normalized Gaussian step weight based on distance to caster surface */
+        float step_weight = exp(-d_to_ray * d_to_ray / (2.0f * 0.08f * 0.08f));
+        accum_refr_radiance += step_radiance * step_weight;
+        total_refr_weight += step_weight;
+      }
+    }
+
+    if (total_refr_weight > 1e-4f) {
+      light_caustic_accum += accum_refr_radiance / total_refr_weight;
+    }
+  }
+
+  /* =========================================================================
+   * 2. Reflective Catacaustics (Cardioid / Nephroid)
+   * ========================================================================= */
+  if ((srt.flags & 2) != 0) {
+    const int refl_samples = 16;
+    float max_refl_screen_r = 0.45f;
+    float beam_spread_dist = max(0.012f, srt.blur * 0.25f);
+    float inv_2sigma_sq = 0.5f / (beam_spread_dist * beam_spread_dist);
+
+    float total_refl_weight = 0.0f;
+    float3 accum_refl_radiance = float3(0.0f);
+
+    for (int i = 0; i < refl_samples; i++) {
+      float theta = float(i) * 2.39996323f + rot;
+      float r = max_refl_screen_r * sqrt((float(i) + fract(dither * 3.17f)) / float(refl_samples));
+      float2 sample_uv = screen_uv + float2(cos(theta), sin(theta)) * r;
+
+      if (any(lessThan(sample_uv, float2(0.002f))) || any(greaterThan(sample_uv, float2(0.998f)))) {
+        continue;
+      }
+
+      int2 sample_texel = int2(sample_uv * float2(render_size));
+      float c_depth = texelFetch(hiz.hiz_tx, sample_texel, 0).r;
+      if (c_depth >= 1.0f || c_depth <= 0.0f) {
+        continue;
+      }
+
+      float3 P_c = view.point_screen_to_world(float3(sample_uv, c_depth));
+      float dist_sq = dot(P_recv - P_c, P_recv - P_c);
+      if (dist_sq < 0.0001f || dist_sq > (max_dist * max_dist)) {
+        continue;
+      }
+
+      const gbuffer::Layers c_gbuf_sample = reader.read_layers(sample_texel);
+      for (int l = 0; l < GBUFFER_LAYER_MAX; l++) {
+        const ClosureUndetermined cl = c_gbuf_sample.layer[l];
+        if (cl.type == CLOSURE_NONE_ID) {
+          break;
+        }
+
+        float roughness = cl.data.x;
+        bool is_refl = (cl.type == CLOSURE_BSDF_MICROFACET_GGX_REFLECTION_ID && roughness < 0.35f);
+        if (!is_refl) {
+          continue;
+        }
+
+        float3 N_c = cl.N;
+        float cos_i = dot(N_c, L);
+        if (cos_i > 0.02f) {
+          float3 v_refl = normalize(-L + 2.0f * cos_i * N_c);
+          float denom = dot(v_refl, N_recv);
+          if (denom < -0.02f) {
+            float t_hit = dot(P_recv - P_c, N_recv) / denom;
+            if (t_hit > 0.005f && t_hit < max_dist) {
+              float3 P_hit = P_c + t_hit * v_refl;
+              float err_dist = length(P_recv - P_hit);
+
+              /* Smooth Gaussian kernel without hard cutoff */
+              float w_refl = exp(-err_dist * err_dist * inv_2sigma_sq);
+              if (w_refl > 1e-3f) {
+                float geom_atten = cos_i / (1.0f + 0.35f * t_hit * t_hit);
+                float sample_w = w_refl * geom_atten;
+                accum_refl_radiance += light_col * sample_w * 2.8f;
+                total_refl_weight += w_refl;
+              }
+            }
+          }
+        }
+      }
+    }
+
+    if (total_refl_weight > 0.0f) {
+      light_caustic_accum += accum_refl_radiance / total_refl_weight;
+    }
+  }
+
+  return light_caustic_accum;
+}
+
+[[fragment]]
+void caustics_frag([[resource_table]] const CausticsEval &srt,
+                   [[resource_table]] const draw::View &views,
+                   [[resource_table]] const Uniform &uni,
+                   [[resource_table]] const HiZ &hiz,
+                   [[resource_table]] const LightRenderData &lrd,
+                   [[resource_table]] const gbuffer::Reader &reader,
+                   [[frag_coord]] const float4 frag_co,
+                   [[in]] const VertOut &v_out,
+                   [[out]] FragOut &frag_out)
+{
+  frag_out.combined = float4(0.0f);
+
+  if (srt.intensity <= 0.0f || srt.flags == 0) {
+    return;
+  }
+
+  int2 texel = int2(frag_co.xy);
+  float depth = texelFetch(hiz.hiz_tx, texel, 0).r;
+  if (depth >= 1.0f || depth <= 0.0f) {
+    return;
+  }
+
+  const ViewMatrices view = views.get(0);
+  float3 P_recv = view.point_screen_to_world(float3(v_out.screen_uv, depth));
+
+  const gbuffer::Layers recv_gbuf = reader.read_layers(texel);
+  float3 N_recv = recv_gbuf.surface_N();
+  if (dot(N_recv, N_recv) < 0.1f) {
+    N_recv = normalize(cross(gpu_dfdx(P_recv), gpu_dfdy(P_recv)));
+  }
+  if (dot(N_recv, N_recv) < 0.1f) {
+    return;
+  }
+
+  /* Prevent caustics on pure transmissive surfaces so caustics land on receiver tables/floors/interior. */
+  if (recv_gbuf.layer[0].type == CLOSURE_BSDF_MICROFACET_GGX_REFRACTION_ID) {
+    return;
+  }
+
+  const LightCullingData &culling = lrd.light_cull_buf;
+  float3 total_caustics = float3(0.0f);
+  float2 subpixel = uni.uniform_buf.film.subpixel_offset;
+  float dither = random::interleaved_gradient(frag_co.xy, subpixel.x, subpixel.y);
+  int2 render_size = textureSize(reader.gbuf_header_tx, 0).xy;
+
+  /* Evaluate Directional lights (Sun). */
+  for (uint l_idx = culling.local_lights_len; l_idx < culling.items_count; l_idx++) {
+    LightData light = lrd.light_buf[l_idx];
+    total_caustics += eval_single_light_caustics(reader,
+                                                 hiz,
+                                                 srt,
+                                                 view,
+                                                 light,
+                                                 true,
+                                                 P_recv,
+                                                 N_recv,
+                                                 v_out.screen_uv,
+                                                 dither,
+                                                 render_size);
+  }
+
+  /* Evaluate Local lights (Point, Spot, Area). */
+  uint local_eval_count = min(culling.visible_count, 4u);
+  for (uint l_idx = 0; l_idx < local_eval_count; l_idx++) {
+    LightData light = lrd.light_buf[l_idx];
+    total_caustics += eval_single_light_caustics(reader,
+                                                 hiz,
+                                                 srt,
+                                                 view,
+                                                 light,
+                                                 false,
+                                                 P_recv,
+                                                 N_recv,
+                                                 v_out.screen_uv,
+                                                 dither,
+                                                 render_size);
+  }
+
+  total_caustics *= srt.intensity;
+
+  /* Bound caustic irradiance to prevent digital blown-out clipping, matching Cycles MNEE */
+  total_caustics = min(total_caustics, float3(20.0f));
+
+  /* Physically ground caustics: incident caustic irradiance reflects off the receiver surface
+   * modulated by its diffuse albedo, allowing tabletop textures (wood grain) to shine through. */
+  float3 recv_albedo = clamp(recv_gbuf.layer[0].color, 0.05f, 1.0f);
+  total_caustics *= recv_albedo;
+
+  float3 safe_caustics = colorspace::safe_color(total_caustics);
+  frag_out.combined = float4(safe_caustics, 0.0f);
+}
