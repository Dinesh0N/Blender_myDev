@@ -0,0 +1,72 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup eevee
+ */
+
+#include "eevee_caustics.hh"
+#include "eevee_instance.hh"
+
+namespace blender::eevee {
+
+void CausticsModule::init()
+{
+  const SceneEEVEE &sce_eevee = inst_.scene->eevee;
+  enabled_ = (sce_eevee.flag & SCE_EEVEE_CAUSTICS_ENABLED) != 0 &&
+             (sce_eevee.caustics_intensity > 0.0f);
+
+  data_.intensity = sce_eevee.caustics_intensity;
+  data_.dispersion = sce_eevee.caustics_dispersion;
+  data_.blur = sce_eevee.caustics_blur;
+  data_.flags = 0;
+  if (sce_eevee.flag & SCE_EEVEE_CAUSTICS_REFRACTIVE) {
+    data_.flags |= 1;
+  }
+  if (sce_eevee.flag & SCE_EEVEE_CAUSTICS_REFLECTIVE) {
+    data_.flags |= 2;
+  }
+}
+
+void CausticsModule::sync()
+{
+  if (!enabled_) {
+    return;
+  }
+
+  gpu::Shader *sh = inst_.shaders.static_shader_get(CAUSTICS_EVAL);
+
+  caustics_ps_.init();
+  caustics_ps_.shader_set(sh);
+  caustics_ps_.state_set(DRW_STATE_WRITE_COLOR | DRW_STATE_CLIP_CONTROL_UNIT_RANGE |
+                          DRW_STATE_BLEND_ADD_FULL);
+
+  caustics_ps_.push_constant("intensity", data_.intensity);
+  caustics_ps_.push_constant("dispersion", data_.dispersion);
+  caustics_ps_.push_constant("blur", data_.blur);
+  caustics_ps_.push_constant("flags", data_.flags);
+
+  caustics_ps_.bind_resources(inst_.uniform_data);
+  caustics_ps_.bind_resources(inst_.lights);
+  caustics_ps_.bind_resources(inst_.hiz_buffer.front);
+  caustics_ps_.bind_resources(inst_.gbuffer);
+
+  caustics_ps_.draw_procedural(GPU_PRIM_TRIS, 1, 3);
+}
+
+void CausticsModule::render(View &view, draw::Framebuffer &combined_fb)
+{
+  if (!enabled_) {
+    return;
+  }
+
+  inst_.hiz_buffer.update();
+
+  GPU_debug_group_begin("Caustics");
+  GPU_framebuffer_bind(combined_fb);
+  inst_.manager->submit(caustics_ps_, view);
+  GPU_debug_group_end();
+}
+
+}  // namespace blender::eevee
